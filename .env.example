# ---- Core ----
PORT=3000
NODE_ENV=production
APP_URL=https://yourdomain.com
JWT_SECRET=change_this_to_a_long_random_string
# Set to true once you're serving over https:// (nginx + certbot). Leave
# false/unset while testing over plain http://ip:3000, or logins will fail.
COOKIE_SECURE=false

# The account with this email is automatically granted admin access
# (see /admin.html) — checked on every login, so you can set this any time.
ADMIN_EMAIL=you@example.com

# Shown in the site footer / support links.
SUPPORT_EMAIL=support@harisreesslalerts.com

# ---- Database (MySQL 8.0) ----
DB_TYPE=mysql
MYSQL_HOST=harisree-mysql
MYSQL_PORT=3306
MYSQL_USER=harisree_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=harisree_ssl
# Fallback SQLite path (if running locally without MySQL)
DB_PATH=./data/harisree.db

# ---- Email (used to send expiry alert emails) ----
# Preferred: Mailjet's HTTP API. It sends over HTTPS (port 443), which
# hosting providers essentially never block — unlike SMTP ports (25/465/587),
# which DigitalOcean and others block outbound by default on every new
# droplet. Get these from Mailjet dashboard > Account Settings > API Key
# Management. If both are set, Mailjet is used and the SMTP settings below
# are ignored.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Fallback: plain SMTP (only used if the Mailjet keys above are blank).
# Same port-blocking caveat applies — 587 usually fine, 25 usually blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_app_password

# Used by both methods above — must be a sender address verified in
# whichever provider you're using (Mailjet requires sender verification).
MAIL_FROM="SSL Alerts <alerts@yourdomain.com>"

# ---- Stripe (subscription billing — optional, alternative to Razorpay below) ----
# Leave blank to run in "manual plan" mode (no card payments yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MICRO=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_UNLIMITED=

# ---- Razorpay (subscription billing) ----
# From Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks, after you add the webhook URL below
RAZORPAY_WEBHOOK_SECRET=
# Create these under Dashboard > Subscriptions > Plans (one monthly plan per
# tier), then paste the plan_XXXXXXXX IDs here.
RAZORPAY_PLAN_MICRO=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_AGENCY=
RAZORPAY_PLAN_UNLIMITED=

# ---- Cert check tuning ----
CHECK_CONCURRENCY=10
CHECK_CRON="0 3 * * *"
# How often to re-check domains that are currently warning/critical/expired
# and unacknowledged, to decide whether to send another alert email.
ALERT_CHECK_CRON="*/10 * * * *"
